PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Required: MongoDB Connection String (Local MongoDB or MongoDB Atlas M0)
# e.g. mongodb://127.0.0.1:27017/leadflow OR mongodb+srv://<user>:<password>@cluster.mongodb.net/leadflow
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow

# Required: JWT Secret and Expiration for Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Optional: Email Service Configuration (SMTP)
# Application boots safely even if unconfigured. Sending emails requires these variables.
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM_NAME="LeadFlow"
EMAIL_FROM_ADDRESS=noreply@leadflow.io

# Optional: Redis Configuration for Background Queue (BullMQ)
# Application boots safely even if unconfigured. Background worker operations require Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Discovery Provider Configuration
# Options:
#   - development: Default ₹0 sandbox simulation
#   - osm_combined: Recommended Discovery V2 (Nominatim + Overpass bounded POI discovery with deduplication)
#   - openstreetmap: Nominatim only
#   - overpass: Overpass API only
DISCOVERY_PROVIDER=osm_combined
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT="LeadFlow-Discovery-Platform/1.0 (contact@leadflow.io)"

# Experimental Apify Google Maps Discovery Configuration
# Backend-only: Never expose APIFY_API_TOKEN to client, browser, or Git
APIFY_ENABLED=false
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_MAX_RESULTS=20
APIFY_MAX_RUNS_PER_SESSION=5
APIFY_MAX_RUNS_PER_WORKSPACE_PER_DAY=10
